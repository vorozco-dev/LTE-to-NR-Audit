<?xml version="1.0" encoding="UTF-8"?>
<!--
  OTLKM LTE to NR Audit (Ericsson) - instalador MSI (WiX Toolset 5).

  Instalación por usuario en %LocalAppData%\LteNrAuditEricsson (no pide administrador).
  La app crea db\, output\ y log\ junto al .exe; como el instalador no crea esas carpetas,
  se conservan al actualizar o desinstalar. conf\ (freq_band.csv) sí se instala y se reemplaza al actualizar.

  Se construye con build_tools\build_msi.ps1 (define AppDir, AppIcon y Version).
  UpgradeCode NO debe cambiar nunca: es lo que permite que una versión nueva reemplace a la anterior.
  Es propio de esta app; no copiarlo de ni a otro instalador (Propagation Vector tiene el suyo).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="OTLKM LTE to NR Audit (Ericsson)"
           Manufacturer="OTLKM"
           Version="$(var.Version)"
           Scope="perUser"
           Compressed="yes"
           UpgradeCode="A60B6691-3F8F-4438-99BA-3B6A49AEE439">

    <SummaryInformation Description="OTLKM LTE to NR Audit (Ericsson) $(var.Version)" />
    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de LTE to NR Audit (Ericsson) instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="LteNrAuditEricsson" />
    </StandardDirectory>

    <!-- Todos los archivos de la carpeta generada por PyInstaller (modo carpeta) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppDir)\**" />
    </ComponentGroup>

    <!-- Accesos directos: menú Inicio y Escritorio -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Shortcuts" Guid="8E3E405E-74B8-4284-95B4-45F2FC91682A">
        <Shortcut Id="StartMenuShortcut" Name="LTE to NR Audit (Ericsson)"
                  Description="OTLKM LTE to NR Audit (Ericsson)"
                  Target="[INSTALLFOLDER]LteNrAuditEricsson.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="LTE to NR Audit (Ericsson)"
                  Description="OTLKM LTE to NR Audit (Ericsson)"
                  Target="[INSTALLFOLDER]LteNrAuditEricsson.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\OTLKM\LteNrAuditEricsson"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="LTE to NR Audit (Ericsson)">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
